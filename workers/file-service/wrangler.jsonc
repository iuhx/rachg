{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "rachg-file-service",
  "account_id": "183126450d0d9188448b6265c97e595f",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database Binding for file metadata
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "d1rachg",
      "database_id": "804f589f-b81d-4884-8878-91bd8e6611f3"
    }
  ],

  // R2 Bucket Binding (reusing your existing R2 bucket r2rachg, transfers/ prefix isolation)
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "r2rachg"
    }
  ],

  // Service configuration & Limits
  "vars": {
    "MAX_STORAGE_BYTES": "4294967296", // 4GB max total active storage cap
    "DEFAULT_EXPIRATION_HOURS": "48",
    "ALLOWED_ORIGINS": "https://rachg.com",
    "ACCESS_TEAM_DOMAIN": "https://rachg.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "c957cd24c86488ef41c73ce7b915a92b348e6babb849441f41c4a3e4a8f791cb"
  }
}
